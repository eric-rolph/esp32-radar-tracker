# ESP32 Radar Tracker - Git Ignore

# ========================================
# Python
# ========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
venv/
env/
ENV/
.venv

# ========================================
# Arduino / PlatformIO
# ========================================
.pio/
.vscode/
.pioenvs
.piolibdeps
.clang_complete
.gcc-flags.json
*.elf
*.bin
*.hex

# ========================================
# CircuitPython
# ========================================
.Trashes
._*
.metadata_never_index
.fseventsd
boot_out.txt

# ========================================
# System Files
# ========================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ========================================
# IDE
# ========================================
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ========================================
# Backup Files
# ========================================
*.bak
*.backup
Backup_*/
*.zip

# ========================================
# Serial Port Config (user-specific)
# ========================================
serial_config.py
com_port.txt

# ========================================
# Temporary Files
# ========================================
*.tmp
*.temp
tmp/
temp/

# ========================================
# BeamNG maps pack: track source, not build output
# ========================================
# Public GIS downloads, generated level trees and dist ZIPs are rebuilt by
# `python beamng_maps/build.py <key> all`; only specs, generators and
# authoring evidence are tracked.
beamng_maps/*/data/
beamng_maps/*/mod/
beamng_maps/*/dist/
beamng_maps/*/textures/
beamng_maps/_downloads/
beamng_maps/**/__pycache__/

# Test caches
.pytest_cache/
